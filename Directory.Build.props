<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AnalysisLevel>8.0</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Development builds only. Public-release packaging must explicitly disable this. -->
    <ConvergenceDevelopmentSolo Condition="'$(ConvergenceDevelopmentSolo)' == ''">true</ConvergenceDevelopmentSolo>
    <DefineConstants Condition="'$(ConvergenceDevelopmentSolo)' == 'true'">$(DefineConstants);CONVERGENCE_DEVELOPMENT_SOLO</DefineConstants>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
