        Tooltip: "第一断絶の候補アリーナを固定する\n開発ビルド：全員Readyで実験用Raidを開始"
      }
      ResuscitationKitItem: {
        DisplayName: 蘇生キット
        Tooltip: "Downした味方の8タイル以内で、使用ボタンを2秒間長押し\n静止して使用。成功時に共有蘇生トークンを1消費（アイテムは消費しない）"
      }
    }
    NPCs: {
      FirstSeverancePrototypeBoss.DisplayName: 無響の唱導者
