Mods: {
  Convergence: {
    Items: {
      FoundationCoreItem: {
        DisplayName: ファウンデーション・コア
        Tooltip: "第一断絶の候補アリーナを固定する大型封印装置\n足元の発光コンソールを右クリック\n開発ビルド：全員Readyで実験用Raidを開始"
      }
      ResuscitationKitItem: {
        DisplayName: 蘇生キット
        Tooltip: "Downした味方の8タイル以内で使用すると、HP35％で即時蘇生\n消費・共有トークンなし。移動中や空中でも使用可能\n蘇生された本人は60秒間、再蘇生を受けられない"
      }
    }
    NPCs: {
      FirstSeverancePrototypeBoss.DisplayName: 無響の唱導者
      FirstSeverancePrototypePylon.DisplayName: 断絶のパイロン
    }
    Buffs.RecoveryLockoutDebuff: {
      DisplayName: 再構成不応期
      Description: 蘇生後60秒間、再び蘇生を受けることができない。味方を蘇生することはできる。
    }
    Tiles: {
      FoundationCoreTile: {
        MapEntry: ファウンデーション・コア
      }
    }
    UI: {
      FirstSeverance: {
        ActivationRejected: "ファウンデーション・コアの起動条件を満たしていません: {0}"
        RequestRejected: "操作できません: {0}"
