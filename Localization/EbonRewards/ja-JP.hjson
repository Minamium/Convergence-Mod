Mods: {
	Convergence: {
		Items: {
			EbonHatbox: {
				DisplayName: 黒絹の帽子箱
				Tooltip:
					'''
					右クリックで開封
					黒絹の館の5種類の武器から1種類が出る（各20％）
					全5種類を集め、作業台で「最後の円舞曲」を作れる
					館の主から渡される、黒い絹で結ばれた手土産
					'''
			}
			EbonMoonshear: {
				DisplayName: 月裁ちの大鋏
				Tooltip:
					'''
					巨大な裁ち鋏を二刀流のように振る4段の型
					4段目は鋏を閉じて断ち切る
					当てた敵に裁ち線の印がつく（1体につき最大5つ）
					右クリック：チャコの線に沿って裂く。線上の印が順に弾ける
					'''
			}
			EbonLoomHarp: {
				DisplayName: 月光の糸竪琴
				Tooltip:
					'''
					銀の針の矢を放ち、その跡に絹糸を張る
					右クリック：張った糸を爪弾き、糸に触れた敵を切る
					糸は最大8本まで張れる
					'''
			}
			EbonThimble: {
				DisplayName: 黒絹の指ぬき
				Tooltip:
					'''
					押し続けると、館の家具を1拍に1つずつ糸で浮かせる
					離すと、カーソルへ次々に叩きつける
					8つすべて浮かせてから離すと、グランドピアノが落ちてくる
					'''
			}
			EbonChandelierPole: {
				DisplayName: 舞踏会のシャンデリア
				Tooltip:
					'''
					敵の頭上に吊られ、糸を切られて落ちるシャンデリアを召喚する
					砕けたシャンデリアは自ら編み直され、巻き上げられて戻る
					複数いると拍に合わせて順に落ちる
					'''
			}
			EbonSeveringSilk: {
				DisplayName: 断ち糸
				Tooltip:
					'''
					糸巻きを投げ、戦場に絹糸を張り巡らせる
					ステルス攻撃：刺繍鋏を投げ、張った糸をすべて一斉に断ち切る
					'''
			}
			EbonLastWaltz: {
				DisplayName: 最後の円舞曲
				Tooltip:
					'''
					ノワレットがあなたに付き添い、家具を投げ、絹のワルツで敵をなぎ払う
					ミニオン枠を10使う。同時に1人だけ
					'''
			}
		}
	}
}
