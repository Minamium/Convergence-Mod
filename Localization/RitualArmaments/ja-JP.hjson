      "RitualArmaments": {
        "NullRefrain": {
          "Name": "断唱・虚掌",
          "Tooltip": "ラクリモーサの遠隔の双腕を顕現する\n左クリック：巨大化する双爪を左右交互に振る直接近接攻撃\n装備中6秒で圧壊のチャージが完了\n右クリック：予備動作の後、指定地点を両手で挟み潰す\n持ち替え・行動不能中はチャージ停止。死亡で消失\n閉幕の宝箱から等確率で手に入る5武器のひとつ"
        },
        "PaleMeridian": {
          "Name": "蒼白の子午線",
          "Tooltip": "押し続けると数秒かけて五基の攻城砲を増設しながら射撃する\n砲列が合体・装填し、緩急のあるチャージから高速制圧射撃へ移行\n放す・持ち替えで終了。弾丸を使用し75％の確率で消費しない\n閉幕の宝箱から等確率で手に入る5武器のひとつ"
        },
        "LacunaTestament": {
          "Name": "欠落の遺言",
          "Tooltip": "押し続けると一つの魔法陣から攻撃を開始し、上下へ六つを加速的に増設する\n約6.8秒で魔法陣を合成、0.8秒の圧縮チャージを経て強力な一本の光線を維持する\n照射中も照準変更可能。放す・持ち替え・マナ切れで終了\nマナを継続消費する。自動でマナポーションを使わせることはない\n閉幕の宝箱から等確率で手に入る5武器のひとつ"
        },
        "ChoirOfTheUnmade": {
          "Name": "未成の聖歌隊",
          "Tooltip": "ミニオン枠を一つ使い、儀式を育てながら個別に攻撃する唱導機関を召喚する\n約11秒の一楽章：個別射撃、集結、チャージ、3秒間の合唱照射\n全機の力が一つの大オルガンに集まる。通常のミニオン標的指定に対応\n閉幕の宝箱から等確率で手に入る5武器のひとつ"
        },
        "LastWitness": {
          "Name": "最後の証人",
          "Tooltip": "押し続けると六つの証人が順に現れ、それぞれが追尾する破片を放つ\n証人が一つの重い祭刃へ合成し、緩急をつけて強力な帰還刃を射出する\nステルスは最後の祭刃と収束処刑を強化する\n約4.7秒の儀式。発射前に放すと中断\n閉幕の宝箱から等確率で手に入る5武器のひとつ"
        }
      },
