{
  "Mods": {
    "Convergence": {
      "RitualArmaments": {
        "NullRefrain": {
          "Name": "Null Refrain — Cantor's Claws",
          "Tooltip": "Manifest the distant arms of the Null Cantor\nLeft click: alternate enormous expanding true-melee claws\nHold this weapon for 6 seconds to charge one execution\nRight click: both hands crush the clicked location after a short windup\nThe charge pauses while unequipped or incapacitated; death clears it\nTrade this raid weapon for another class form at a Work Bench"
        },
        "PaleMeridian": {
          "Name": "Pale Meridian",
          "Tooltip": "Deploy three floating ritual cannons and convert bullets into homing lances.\nEvery sixth volley converges with greater power and piercing.\n75% chance not to consume ammunition.\nExchange one-for-one with other ritual armaments at a Work Bench."
        },
        "LacunaTestament": {
          "Name": "Lacuna Testament",
          "Tooltip": "Unfold a floating archive and three lenses that release homing rays.\nEvery fourth cast opens the archive fully for an empowered convergence.\nExchange one-for-one with other ritual armaments at a Work Bench."
        },
        "ChoirOfTheUnmade": {
          "Name": "Choir of the Unmade",
          "Tooltip": "Summon a one-slot voice chamber.\nThe choir assembles into a great organ for its empowered third note.\nSupports normal minion target commands.\nExchange one-for-one with other ritual armaments at a Work Bench."
        },
        "LastWitness": {
          "Name": "Last Witness",
          "Tooltip": "Cast a homing triangular blade that tears a dark path and returns.\nStealth strikes manifest three colossal seals around the target.\nThe seals briefly track, lock, then converge into one triangular execution.\nExchange one-for-one with other ritual armaments at a Work Bench."
        }
      },
      "Buffs": {
        "ChoirOfTheUnmadeBuff": {
          "DisplayName": "Choir of the Unmade",
          "Description": "The sentinels sing for you"
        }
      }
    }
  }
}
