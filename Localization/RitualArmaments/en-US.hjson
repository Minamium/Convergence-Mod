Mods: {
	Convergence: {
		RitualArmaments: {
			NullRefrain: {
				Name: Null Refrain — Lacrimosa's Claws
				Tooltip:
					'''
					Manifest the distant hands of Lacrimosa
					Left click: a three-step true-melee kata: the right hand rakes down, the left rakes up, both hands clap
					Landing strokes lights the six heart beads on the hands, faster while the hits keep coming; holding fills them slowly
					Right click with six beads lit: both hands fly to the cursor, seize the enemy there and crush it
					The beads pause while unequipped or incapacitated; death empties them
					One of five equally likely rewards from the Curtainfall Treasure Box
					'''
			}

			PaleMeridian: {
				Name: Pale Meridian
				Tooltip:
					'''
					Hold to build a music-box siege rifle while firing; every shot rings the next note of its tune.
					Each brass part that clicks in fires faster; once complete, the wind-up key turns and the gun overcharges into rapid homing fire.
					Release to fire a white meridian through the cursor; held longer, it splits into a lattice of light.
					Uses bullets; 75% chance not to consume ammo.
					One of five equally likely rewards from the Curtainfall Treasure Box.
					'''
			}

			LacunaTestament: {
				Name: Lacuna Testament
				Tooltip:
					'''
					Hold: porcelain irises open one by one around the testament, each firing small seeking void pellets.
					After about 5.7 seconds the seven irises merge before your hand into one great aperture.
					After a 0.8-second charge it pours out a black-cored beam that pulses and slowly widens.
					The beam can be turned while held. Releasing, switching items or running out of mana ends it.
					Consumes mana continuously; never triggers automatic mana potions.
					One of five equally likely rewards from the Curtainfall Treasure Box.
					'''
			}

			ChoirOfTheUnmade: {
				Name: Choir of the Unmade
				Tooltip:
					'''
					Summon an unfinished porcelain chorister (1 minion slot)
					The choir sings homing notes on the beat, then lines up before a pipe organ above you for a 3-second chorus beam
					Every chorister adds a voice to the chord and its strength to the one beam; supports minion target commands
					One of five equally likely rewards from the Curtainfall Treasure Box
					'''
			}

			LastWitness: {
				Name: Last Witness
				Tooltip:
					'''
					Hold: an execution blade hangs before you; six testimonies break from its edge as seeking porcelain shards
					After the sixth the sentence is sealed: the blade is swung back and hurled, spinning
					It bites its target, turns in it twice and returns to hang again
					Stealth strike: three judgement swords fall around the target as stakes and close into a triangle of light
					About 4.7 seconds per sentence; releasing before the seal cancels, after it the throw completes
					One of five equally likely rewards from the Curtainfall Treasure Box.
					'''
			}
		}

		Projectiles: {
			WitnessHang.DisplayName: Last Witness
			WitnessThrownBlade.DisplayName: Last Witness
			WitnessShard.DisplayName: Testimony Shard
			WitnessJudgement.DisplayName: Triangle Judgement
		}

		Buffs: {
			ChoirOfTheUnmadeBuff: {
				DisplayName: Choir of the Unmade
				Description: Unfinished dolls sing for you
			}
		}

		Projectiles: {
			ChoirChorister.DisplayName: Unmade Chorister
			ChoirSungNote.DisplayName: Sung Note
			ChoirChorus.DisplayName: Chorus of the Unmade
		}
	}
}
