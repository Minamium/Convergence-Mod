Mods: {
	Convergence: {
		UI: {
			PreparationDeployment: {
				Deploying: FIELD DEPLOYING — Ready check opens after assembly
				Ready: READY
				PlayerUnavailable: Every server player must be alive and available. Wait for respawn, then activate again.
				TooManyPlayers: This Raid supports up to four players. All server players are included; no partial group will start.
