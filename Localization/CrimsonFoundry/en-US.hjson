Mods: {
	Convergence: {
		Items: {
			CrimsonConductor: {
				DisplayName: Scarlet Grimoire
				Tooltip:
					'''
					Use on a Foundation Core pedestal to prepare Scarlet Invocation; everyone confirms Ready
					Face each apparition alone; at 20% HP it finishes its cycle. The three are sacrificed to one giant final apparition
					Right-click to cancel your preparation. Reusable
					Rehearsal: hostile damage 1, reduced HP; 1–8 players; late arrivals spectate
					'''
			}
			CrimsonPact: {
				DisplayName: Scarlet Covenant
				Tooltip: '''
					Summons a human-sized scarlet conjurer to accompany you
					Follows on foot or floats; opposing seals clamp up to 10 enemies with beams, prioritizing highest current HP
					Requires 10 minion slots. Does not count as a Raid participant
					'''
			}
		}

		NPCs.CrimsonBoss.DisplayName: Vespera — The Scarlet Conjurer
		NPCs.CrimsonEffigy.DisplayName: Scarlet Apparition
		Projectiles.CrimsonAttack.DisplayName: Scarlet Invocation
		Projectiles.CrimsonCompanion.DisplayName: Scarlet Companion
		Projectiles.CrimsonCompanionRay.DisplayName: Scarlet Covenant
		Buffs.CrimsonPactBuff: { DisplayName: "Scarlet Covenant" Description: "The scarlet conjurer accompanies you" }
		CrimsonFoundry.RaidTitle: SCARLET INVOCATION
		CrimsonFoundry.Rejected: Preparation rejected. Hold the conductor near a Foundation Core pedestal, finish other encounters, and use a party of at most eight.

		Configs: {
			CrimsonVisualConfig: {
				DisplayName: Scarlet Invocation presentation

				ReducedEffects: {
					Label: Reduce decorative effects
					Tooltip: Preserves warnings and damage footprints. Reduces decorative particles and camera shake.
				}

				CinematicCamera: { Label: "Phase-transition camera" Tooltip: "Gentle local pan during protected transitions only; never blocks controls." }

				ScreenShake: {
					Label: Camera shake
					Tooltip: Brief directed shake on attacks and manifestations.
				}
			}
		}
	}
}
