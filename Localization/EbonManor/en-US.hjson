Mods: {
	Convergence: {
		EbonManor.Rejected: The manor would not open. Check the pedestal, party size and free world space.

		Items: {
			EbonInvitation: {
				DisplayName: Black Invitation
				Tooltip:
					'''
					Use on a Foundation Core to prepare Waltz of the Ebon Manor
					All connected players confirm Ready; 1–8 players, multiplayer recommended
					The mistress of a moonlit manor weaves its furniture into a dance
					Right-click while holding it to cancel preparation
					Not consumed
					'''
			}
		}

		NPCs: {
			EbonBoss.DisplayName: Noirette — Mistress of the Ebon Manor
		}

		Projectiles: {
			EbonAttack.DisplayName: Silken Snare
			EbonStitch.DisplayName: Binding Stitch
			EbonStitchStrike.DisplayName: Torn Stitch
		}

		EbonRecovery: {
			NoTarget: No downed ally within 8 tiles.
			Locked: This ally cannot be revived again yet (60-second recovery lockout).
			RequiresKit: Hold the Resuscitation Kit to revive an ally.
			Invalid: Recovery is unavailable for this participant or encounter state.
			DefeatReason: "{0} was bound in the manor's silk."
		}

		Buffs: {
			EbonDownedDebuff: {
				DisplayName: Downed
				Description: "Unable to move or attack. An ally can revive you with a Resuscitation Kit."
			}
		}

		Configs: {
			EbonVisualConfig: {
				DisplayName: Ebon Manor Presentation

				ReducedEffects: {
					Label: Reduced effects
					Tooltip: Reduce optional dust, afterimages and movement without hiding attacks
				}

				ScreenShake: {
					Label: Screen shake
					Tooltip: Allow bounded local impact shake
				}
			}
		}
	}
}
